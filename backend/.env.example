MOVEGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
MOVEGUARD_API_KEY=

MOVEGUARD_POSE_ESTIMATOR=mediapipe
POSE_MODEL_PATH=pose_landmarker_lite.task
MOVEGUARD_MAX_POSES=4
MOVEGUARD_POSE_MIN_CONFIDENCE=0.5

MOVEGUARD_HAND_ESTIMATOR=mediapipe
HAND_MODEL_PATH=hand_landmarker.task
