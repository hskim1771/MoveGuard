MOVEGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
MOVEGUARD_API_KEY=

MOVEGUARD_POSE_ESTIMATOR=mediapipe
# API default. Request query `model=baseline|rtmw` overrides this per frame.
POSE_MODEL=baseline
POSE_MODEL_PATH=pose_landmarker_lite.task
MOVEGUARD_MAX_POSES=4
MOVEGUARD_POSE_MIN_CONFIDENCE=0.5

# RTMW-l 384x288 uses official OpenMMLab ONNX packages via rtmlib.
# Keep `cpu` for the reproducible A/B default; `cuda` requires a compatible
# onnxruntime-gpu/CUDA installation and should be reported as a separate run.
MOVEGUARD_RTMW_DEVICE=cpu
MOVEGUARD_RTMW_MIN_CONFIDENCE=0.5

MOVEGUARD_HAND_ESTIMATOR=mediapipe
HAND_MODEL_PATH=hand_landmarker.task
MOVEGUARD_HAND_MIN_CONFIDENCE=0.5

# No custom object model is included. Keep this disabled until a trained model
# is available; the API will return objects=[] and configured=false.
MOVEGUARD_OBJECT_DETECTOR=none
OBJECT_DETECTOR_MODEL_PATH=
MOVEGUARD_OBJECT_CLASSES=box,tool,cart,workbench,load
MOVEGUARD_OBJECT_MIN_CONFIDENCE=0.35

# Existing optional Firebase integration
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=
